# Copy to `.env` locally (never commit secrets)

VITE_API_BASE_URL=
VITE_REVENUECAT_API_KEY_IOS=
VITE_REVENUECAT_API_KEY_ANDROID=
VITE_SENTRY_DSN=
# Development Debug panel: leave empty or "true" (on), set "false" to hide entirely
VITE_ENABLE_DEBUG_PANEL=
VITE_GIT_SHA=
# JSON object of booleans, merged first; optional URL below overwrites same keys
# VITE_FEATURE_FLAGS={"betaHome":true}
# VITE_FEATURE_FLAGS_URL=https://example.com/flags.json
