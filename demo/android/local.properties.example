## Copy to local.properties (gitignored) and adjust paths for your machine.
sdk.dir=/Users/YOU/Library/Android/sdk

# JVM 21 — required by Capacitor Android 7.x (AGP 8.7)
# macOS Homebrew: brew install openjdk@21
org.gradle.java.home=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home

# Intel Mac Homebrew (if applicable):
# org.gradle.java.home=/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
