{
  "name": "appspresso",
  "version": "0.6.0",
  "description": "One package for the backbone of mobile and web apps.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "appspresso": "./bin/appspresso.mjs"
  },
  "workspaces": [
    "examples/native-blank",
    "demo",
    "packages/cli-shared",
    "packages/create-appspresso",
    "packages/plugin-sentry",
    "packages/plugin-firebase-auth",
    "packages/plugin-supabase-auth",
    "packages/plugin-posthog",
    "packages/plugin-testing",
    "packages/module-onboarding",
    "packages/module-auth",
    "packages/module-settings",
    "packages/module-notifications",
    "packages/module-subscriptions",
    "packages/studio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && tsc -b && vite build",
    "build:lib": "tsup --config tsup.lib.config.ts",
    "build:lib:fast": "APPSPRESSO_SKIP_DTS=1 tsup --config tsup.lib.config.ts",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:integration": "npm run build:lib && vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "npm run build:lib && vitest run --config vitest.integration.config.ts --coverage",
    "test:integration:watch": "npm run build:lib && vitest --config vitest.integration.config.ts",
    "test:cli": "node --test packages/cli-shared/*.test.mjs",
    "test:create-smoke": "node --test packages/cli-shared/create-smoke.test.mjs",
    "build:plugins": "npm run build:lib && npm run build --workspace=@appspresso/plugin-sentry --workspace=@appspresso/plugin-firebase-auth --workspace=@appspresso/plugin-supabase-auth --workspace=@appspresso/plugin-posthog --workspace=@appspresso/plugin-testing",
    "build:modules": "npm run build:lib && npm run build --workspace=@appspresso/module-onboarding --workspace=@appspresso/module-auth --workspace=@appspresso/module-settings --workspace=@appspresso/module-notifications --workspace=@appspresso/module-subscriptions",
    "test:plugins": "npm run test --workspace=@appspresso/plugin-sentry --workspace=@appspresso/plugin-testing",
    "test:all": "npm run test:run && npm run test:cli && npm run test:integration",
    "verify:maestro-app-id": "node scripts/verify-maestro-app-id.mjs",
    "verify:bundle-budget": "node scripts/verify-demo-bundle-budget.mjs",
    "analyze": "node cli/analyze.mjs",
    "clean": "node -e \"import('./cli/clean.mjs').then(m=>m.runClean(process.cwd(),{yes:true}))\"",
    "audit:ci": "npm audit --audit-level=high",
    "demo:dev": "npm run build:lib && npm run dev -w demo",
    "demo:build": "npm run build:lib && npm run build -w demo",
    "demo:cap-config": "npm run cap:config -w demo",
    "doctor": "appspresso doctor",
    "create:sync-template": "node scripts/sync-create-template.mjs",
    "cap:sync": "appspresso native sync",
    "native:verify:android": "appspresso native verify android",
    "debug:android:logcat": "node scripts/debug/android-logcat.mjs",
    "debug:android:demo": "node scripts/debug/demo-boot-watch.mjs",
    "debug:android:verify-apk": "node scripts/debug/verify-apk-contents.mjs",
    "ci:native:android": "node scripts/ensure-demo-capacitor-deps.mjs && node scripts/ci-prepare-native.mjs android && node scripts/assemble-android-debug.mjs",
    "ci:native:android:blank": "node scripts/ci-prepare-native-blank.mjs && node scripts/assemble-android-blank.mjs",
    "native:blank:install": "node scripts/native-blank-install.mjs",
    "native:blank:bisect-plugins": "node scripts/bisect-native-plugins.mjs",
    "native:demo:bisect-plugins": "node scripts/bisect-demo-plugins.mjs",
    "ci:native:android:debug": "VITE_NATIVE_DEBUG=true VITE_BOOT_TRACE=true npm run ci:native:android",
    "ci:native:ios": "node scripts/ensure-demo-capacitor-deps.mjs && node scripts/ensure-ios-platform.mjs && node scripts/ci-prepare-native.mjs ios && node bin/appspresso.mjs native assemble ios",
    "e2e": "node scripts/e2e/run.mjs all",
    "e2e:android": "node scripts/e2e/run.mjs android",
    "e2e:ios": "node scripts/e2e/run.mjs ios",
    "e2e:smoke": "node scripts/e2e/run.mjs smoke",
    "e2e:list": "node scripts/e2e/run.mjs list",
    "e2e:native:android": "npm run e2e:android",
    "e2e:native:ios": "npm run e2e:ios",
    "cap:open:android": "appspresso native open android",
    "cap:open:ios": "appspresso native open ios",
    "android:sync": "npm run demo:build && appspresso native sync android",
    "ios:sync": "npm run cap:sync",
    "prepublishOnly": "npm run build:lib"
  },
