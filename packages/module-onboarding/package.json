{
  "name": "@appspresso/module-onboarding",
  "version": "0.6.0",
  "description": "First-run onboarding module for Appspresso",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./module.manifest.json": "./module.manifest.json"
  },
  "files": ["dist", "module.manifest.json"],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --tsconfig tsconfig.json --clean --external appspresso --external react --external react-dom --external react-router-dom --external zod"
  },
  "peerDependencies": {
    "appspresso": "^0.6.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "appspresso": "file:../..",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
