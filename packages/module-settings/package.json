{
  "name": "@appspresso/module-settings",
  "version": "0.6.0",
  "description": "Settings, theme, language, and about module for Appspresso",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./module.manifest.json": "./module.manifest.json"
  },
  "files": ["dist", "module.manifest.json"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.json --clean --external appspresso --external zod"
  },
  "peerDependencies": {
    "appspresso": "^0.6.0"
  },
  "devDependencies": {
    "appspresso": "file:../..",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
