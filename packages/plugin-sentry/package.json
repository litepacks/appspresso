{
  "name": "@appspresso/plugin-sentry",
  "version": "0.3.0",
  "description": "Sentry error reporting plugin for Appspresso",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.json --clean --external appspresso --external @sentry/react --external posthog-js",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "appspresso": "^0.3.0",
    "@sentry/react": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "appspresso": "file:../..",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
