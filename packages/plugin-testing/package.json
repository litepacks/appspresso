{
  "name": "@appspresso/plugin-testing",
  "version": "0.3.0",
  "description": "Test utilities for Appspresso plugins",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.json --clean --external appspresso",
    "test": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "appspresso": "^0.3.0"
  },
  "devDependencies": {
    "appspresso": "file:../..",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
