{
  "name": "@appspresso/plugin-supabase-auth",
  "version": "0.3.0",
  "description": "Supabase Auth adapter for Appspresso",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig tsconfig.json --clean --external appspresso --external @supabase/supabase-js"
  },
  "peerDependencies": {
    "appspresso": "^0.3.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "appspresso": "file:../..",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
